doctype html 
html(lang="en")
    head 
        title Community | ReShare
        //- Absolute path for MVC static routing [cite: 21]
        link(rel="stylesheet", href="/style.css")
    body
        div.wrapper
            //- Professional Modular Navigation
            include ./includes/nav.pug

            .container
                header.page-header
                    h1.page-title Community Members
                    p.subtitle Browse neighbors who are actively giving back to the community.

                //- Use the new professional community grid 
                .community-grid
                    if users && users.length > 0
                        each user in users
                            .member-card
                                //- Generates the circular avatar [cite: 23, 24]
                                .member-initial #{user.name ? user.name.charAt(0).toUpperCase() : 'U'}
                                
                                .member-info
                                    h3.member-name #{user.name}
                                    
                                    //- Statistics Badge [cite: 25, 26]
                                    .member-stat
                                        i.bi.bi-gift-fill.me-2
                                        | #{user.item_count || 0} Items Shared
                                    
                                    //- Dynamic "Star" Badge logic for high-impact users
                                    if user.item_count > 5
                                        div.badge.admin.mb-3 ⭐ Star Donor
                                    
                                    a.btn-view-profile(href=`/user/${user.user_id}`) View Profile
                    else
                        .empty-state
                            p No members found in the database. [cite: 27]

                //- Documentation Link: Ties code to requirements [cite: 28]
                .user-story-banner
                    strong User Story: 
                    | "As a user, I want to view the profile of the person listing an item, so that I can understand who I am interacting with and build trust within the network." [cite: 29]