doctype html 
html 
    head 
        title #{item.title} | ReShare
        link(rel="stylesheet", href="/style.css")
    body
        div.wrapper
            include ./includes/nav.pug 
            
            .container
                if query && query.success === 'claimed'
                    .alert-success
                        strong Success! 
                        | This item has been marked as ReShared.

                .product-showcase
                    //- 🖼️ LEFT COLUMN: The sticky, beautifully cropped image
                    .left-column
                        if item.image_url
                            img.item-photo(src=item.image_url, alt=`Photo of ${item.title}`)
                        else
                            img.item-photo(src='/images/default.jpg', alt='No image available')
                            
                    //- 📝 RIGHT COLUMN: The details and actions
                    .right-column
                        h2 #{item.title}
                        
                        .info-card
                            p <strong>Category:</strong> #{item.category_name || 'General'}
                            p <strong>Condition:</strong> #{item.item_condition || 'Used'}
                            p <strong>Location:</strong> #{item.location_name || 'Unknown'} (approx.)
                            p <strong>Posted:</strong> #{item.created_at ? new Date(item.created_at).toLocaleDateString() : 'Recently'}
                            
                        .info-card
                            strong Description:
                            p #{item.description}
                            
                        .info-card
                            strong Listed by:
                            .seller-profile
                                .avatar #{item.owner_name ? item.owner_name.charAt(0).toUpperCase() : '?'}
                                div
                                    p(style="margin: 0; font-weight: bold; color: #1A1A2E;") #{item.owner_name || 'Anonymous User'}
                                    a(href=`/user/${item.user_id}` style="font-size: 0.85rem; color: #00D4A0; text-decoration: none; font-weight: bold;") View Profile →

                        //- 🔘 ACTION BUTTONS
                        .info-actions
                            if session.uid && session.uid !== item.user_id && item.status === 'available'
                                form(action=`/request-chat/${item.listing_id}` method="POST")
                                    button.btn-chat(type="submit") Request to Chat
                            
                            //- 🛠️ UPDATED: Owner Actions now include Edit and Delete
                            else if session.uid === item.user_id && item.status === 'available'
                                .owner-actions
                                    p.status-msg 📢 This is your listing. Is the item gone?
                                    form(action=`/mark-claimed/${item.listing_id}` method="POST" onsubmit="return confirm('Confirming this will close the listing and credit your gifted count. Proceed?')")
                                        button.btn-claimed(type="submit" style="width: 100%; margin-bottom: 10px;") Mark as Claimed ✅
                                    
                                    hr(style="border: 0; border-top: 1px solid #eee; margin: 15px 0;")

                                    p.status-msg ⚙️ Manage your listing:
                                    .owner-manage-group(style="display: flex; gap: 10px;")
                                        a.btn-outline(href=`/edit-item/${item.listing_id}` style="flex: 1; text-align: center;") ✏️ Edit
                                        form(action=`/delete-item/${item.listing_id}` method="POST" style="flex: 1;" onsubmit="return confirm('Are you sure you want to delete your listing? This cannot be undone.')")
                                            button.btn-admin-delete(type="submit" style="width: 100%;") 🗑️ Delete

                            else if item.status === 'completed'
                                .status-badge-completed
                                    h3 🎉 This item has been ReShared!
                                    
                //- 🛡️ ADMIN ZONE (Only visible to admins)
                if session.role === 'admin'
                    .admin-zone
                        h3 🛡️ Admin Master Controls
                        .admin-btn-group
                            a.btn-admin-edit(href=`/admin/edit-item/${item.listing_id}`) Edit Listing
                            form(action=`/admin/delete-item/${item.listing_id}` method="POST" onsubmit="return confirm('WARNING: This will delete everything. Continue?')")
                                button.btn-admin-delete(type="submit") Delete Permanently
                                
                //- 📚 USER STORY REQUIREMENT
                .user-story-banner
                    strong User Story: 
                    | "As a user, I want to view a detailed page for each item to see its condition and contact the owner."