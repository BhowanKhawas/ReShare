doctype html
html(lang="en")
    head
        title Profile: #{user.name} | ReShare
        link(rel="stylesheet", href="/style.css")
    body
        div.wrapper
            include ./includes/nav.pug

            .container
                .page-header.profile-header
                    h1.page-title My Account
                    p.subtitle Manage your details and view your community impact.

                //- Success/Error Messages
                if query && query.success === 'updated'
                    .alert-success Profile updated successfully!
                if query && query.success === 'password'
                    .alert-success Password changed successfully!

                .profile-dashboard-grid
                    //- ⚙️ LEFT COLUMN: Account Settings
                    .settings-sidebar
                        .profile-card
                            //- The Avatar
                            .profile-avatar
                                if user.profile_image
                                    //- Shows the uploaded image if it exists in the database
                                    img(src=user.profile_image alt="Profile Photo")
                                else
                                    //- Falls back to the first letter of the name
                                    | #{user.name ? user.name.charAt(0).toUpperCase() : '?'}
                            
                            h3.profile-name #{user.name}
                            p.profile-email 
                                strong Email: 
                                | #{user.email}

                            hr.divider

                            //- Update Info Form
                            form(action="/update-name", method="POST")
                                input(type="hidden", name="user_id", value=user.user_id)
                                .form-group
                                    label Change Display Name
                                    input(type="text", name="newName", value=user.name, required)
                                button.btn-update.btn-block(type="submit") Update Profile

                            hr.divider

                            //- Change Password Form
                            form(action="/profile/change-password" method="POST")
                                .form-group
                                    label New Password
                                    input(type="password" name="new_password" placeholder="••••••••" required minlength="6")
                                button.btn-outline.btn-block(type="submit") Update Password

                            hr.divider
                            a.btn-logout(href="/logout") 👋 Log Out

                    //- 📊 RIGHT COLUMN: Stats & History
                    .main-content
                        //- 1. The Stats Card
                        .profile-card.stats-card
                            h3 📊 Account Statistics
                            
                            .gift-stat
                                span.gift-icon 🎁
                                span You have gifted
                                strong.gift-number #{user.items_gifted_count || 0}
                                span items to the community!

                            hr.divider.light-divider

                            .profile-details-list
                                p <strong>Account Role:</strong> #{user.role === 'admin' ? '🛡️ Administrator' : '👤 Standard User'}
                                p <strong>Member Since:</strong> #{user.created_at ? new Date(user.created_at).toLocaleDateString() : 'Unknown'}
                                if user.last_login
                                    p <strong>Last Login:</strong> #{new Date(user.last_login).toLocaleString()}

                        //- 2. The Shared Items Card
                        .profile-card
                            h3 📦 My Shared Items
                            
                            if listings && listings.length > 0
                                .listings-grid
                                    each item in listings
                                        .item-card
                                            .item-img-container
                                                img.item-img(src=item.image_url || 'https://placehold.co/400x300')
                                                span.badge(class=item.status) #{item.status}
                                            .item-body
                                                h4.item-title #{item.title}
                                                a.btn-outline.btn-block(href=`/item/${item.listing_id}`) View Listing
                            else
                                .empty-state
                                    p You haven't shared any items yet.
                                    a.btn-green(href="/add-item") Start Sharing Now

                //- User Story Requirement
                .user-story-banner
                    strong User Story: 
                    | "As a user, I want to see my profile and history so I can manage my contributions."