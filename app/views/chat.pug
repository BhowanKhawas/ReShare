doctype html 
html(lang="en")
    head 
        title Chat: #{chatDetails.item_title} | ReShare
        link(rel="stylesheet", href="/style.css")
    body
        div.wrapper
            include ./includes/nav.pug
            
            .container.chat-wrapper
                header.chat-header
                    .header-info
                        h2 #{chatDetails.item_title}
                        p Chatting with <strong>#{chattingWith}</strong>
                    a.btn-back(href="/inbox") ← Back to Inbox

                //- Owner controls for finalizing the gift
                if session.uid === chatDetails.owner_id
                    .completion-box
                        .completion-text
                            strong Item Exchange 
                            p Has #{chattingWith} picked up the item?
                        
                        //- Points to the mark-claimed route using the specific listing ID
                        form(action=`/mark-claimed/${chatDetails.listing_id}` method="POST")
                            input(type="hidden" name="convoId" value=chatDetails.conversation_id)
                            button.btn-green(type="submit") Mark as Claimed

                .chat-messages
                    if messages && messages.length > 0
                        each msg in messages
                            - const isMe = msg.sender_id === session.uid
                            .message-row(class=isMe ? 'msg-me' : 'msg-them') 
                                .bubble 
                                    | #{msg.message_text}
                                small.msg-time #{new Date(msg.sent_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
                    else
                        p.empty-chat Start the conversation below!

                //- Input Form 
                footer.chat-input-area
                    form(action=`/chat/${chatDetails.conversation_id}/send` method="POST")
                        input(type="text" name="message_text" placeholder="Type your message here..." required autocomplete="off")
                        button.btn-green(type="submit") Send